{
  "name": "enclava-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "e2e": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test",
    "e2e:ui": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --ui",
    "e2e:headed": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --headed",
    "e2e:local": "playwright test",
    "e2e:local:ui": "playwright test --ui",
    "e2e:auth": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @auth",
    "e2e:dashboard": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @dashboard",
    "e2e:agents": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @agents",
    "e2e:rag": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @rag",
    "e2e:extract": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @extract",
    "e2e:workflows": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @workflows",
    "e2e:plugins": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @plugins",
    "e2e:llm": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @llm",
    "e2e:settings": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @settings",
    "e2e:admin": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @admin",
    "e2e:governance": "E2E_SKIP_WEBSERVER=1 E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3002} playwright test --grep @governance",
    "check:colors": "bash scripts/check-no-hardcoded-colors.sh",
    "check:plumbing": "bash scripts/check-client-plumbing.sh",
    "check:workflows": "node scripts/check-workflow-surface.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
